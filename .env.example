# MMS Steel Plant Management System - Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!

# Supabase Configuration (Required)
# Found in your Supabase project under Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Groq API Configuration (Optional / Development only)
# For production deployment, set GROQ_API_KEY as a secret in Supabase Edge Functions:
#   supabase secrets set GROQ_API_KEY=gsk_your_groq_api_key
# For local dev testing only:
VITE_GROQ_API_KEY=your_groq_api_key_here
